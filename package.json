{
  "name": "crypto-backend",
  "version": "1.1.0",
  "description": "Crypto backend API with Node.js, TypeScript, Express, and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker:streams": "ts-node-dev --respawn --transpile-only src/workers/streamIngestion.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:streams": "node dist/workers/streamIngestion.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "script:migrate-follows": "ts-node --transpile-only scripts/migrate-follows.ts",
    "script:create-indexes": "ts-node --transpile-only scripts/create-indexes.ts",
    "script:compare-duplicates": "ts-node --transpile-only scripts/compare-coin-duplicates.ts",
    "script:fix-ohlcv": "ts-node --transpile-only scripts/fix-ohlcv-collection.ts",
    "script:set-admin-key": "ts-node --transpile-only scripts/set-admin-key-mongo.ts",
    "script:get-admin-key": "ts-node --transpile-only scripts/get-admin-key-mongo.ts",
    "script:compare-market-trend": "ts-node --transpile-only scripts/compare-market-trend.ts"
  },
  "keywords": [
    "crypto",
    "api",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.0.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "node-cron": "^4.2.1",
    "p-limit": "^3.1.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
